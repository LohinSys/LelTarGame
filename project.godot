; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Lel.tar"
config/description="The endless search for the missing package..."
config/version="a1.0.0-1000"
config/tags=PackedStringArray("lohinsys", "schkewl")
run/main_scene="uid://c47q0efltcsbo"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="uid://rxhb1uaqlsk8"
config/macos_native_icon="res://assets/icons/app/icon.icns"
config/windows_native_icon="res://assets/icons/app/icon.ico"

[audio]

buses/default_bus_layout="uid://cefx2qv3f8hqg"
driver/driver=""

[autoload]

Global="*res://scenes/global.gd"
PlayerStats="*res://scenes/playerStats.gd"
Account="*res://scenes/account.gd"
GameLogic="*res://scenes/gameLogic.gd"
Api="*res://scenes/api.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/leltargame.log"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[dotnet]

project/assembly_name="LelTarGame"

[editor]

naming/node_name_num_separator=3
naming/scene_name_casing=4
version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[file_customization]

folder_colors={
"res://addons/": "red",
"res://assets/": "orange",
"res://assets/backgrounds/": "red",
"res://assets/fonts/": "blue",
"res://assets/icons/": "yellow",
"res://assets/music/": "pink",
"res://assets/sfx/": "green",
"res://assets/sprites/": "purple",
"res://bin/": "gray",
"res://nsis/": "yellow",
"res://scenes/": "blue",
"res://scenes/dialogs/": "red",
"res://scenes/mainMenuScenes/": "teal",
"res://scenes/stages/": "purple"
}

[gui]

theme/custom_font="uid://g5d2kbpjqht2"

[importer_defaults]

texture={
&"compress/channel_pack": 1
}
2d_array_texture={
&"compress/channel_pack": 1
}
3d_texture={
&"compress/channel_pack": 1
}

