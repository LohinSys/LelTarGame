[internationalization]

locale/translations_pot_files=PackedStringArray("res://scenes/account.gd", "res://scenes/login.tscn", "res://scenes/login.gd", "res://scenes/overlay.tscn", "res://scenes/overlay.gd", "res://scenes/pause.tscn", "res://scenes/mainMenuScenes/credits.tscn", "res://scenes/mainMenuScenes/credits.gd", "res://scenes/mainMenuScenes/gameModeSel.tscn", "res://scenes/mainMenuScenes/gameModeSel.gd", "res://scenes/mainMenuScenes/how2play.tscn", "res://scenes/mainMenuScenes/loadingScreen.tscn", "res://scenes/mainMenuScenes/settings.tscn", "res://scenes/mainMenuScenes/settings.gd", "res://scenes/mainMenuScenes/stats.tscn", "res://scenes/mainMenuScenes/stats.gd", "res://scenes/mainMenuScenes/titleScreen.tscn", "res://scenes/mainMenuScenes/titleScreen.gd")
rendering/text_driver="ICU / HarfBuzz / Graphite (Built-in)"

[layer_names]

2d_physics/layer_2="player"
2d_physics/layer_5="pbd"

[memory]

limits/message_queue/max_size_mb=64

[physics]

2d/run_on_separate_thread=true
3d/run_on_separate_thread=true
2d/physics_engine="GodotPhysics2D"
3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
